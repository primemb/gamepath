{
  "name": "gamepath-client",
  "version": "0.2.3",
  "author": "GamePath",
  "private": true,
  "type": "module",
  "description": "A multipath gaming tunnel client for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "npm run engine:build",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "engine:build": "node scripts/build-engine.cjs",
    "service:build": "node scripts/build-service.cjs",
    "relay:msrv": "cargo +1.85.0 check --manifest-path relay/Cargo.toml --ignore-rust-version",
    "relay:configure": "electron scripts/configure-relay.cjs",
    "relay:test": "electron scripts/test-relay.cjs",
    "socks5:test": "electron scripts/test-socks5-relay.cjs",
    "l2tp:test": "electron scripts/test-l2tp-session.cjs",
    "wireguard:import": "electron scripts/import-wireguard.cjs",
    "runtime:test": "electron scripts/test-runtime.cjs",
    "wireguard:probe": "electron scripts/probe-wireguard-routes.cjs",
    "wireguard:session-test": "electron scripts/test-wireguard-session.cjs",
    "service:session-test": "electron scripts/test-service-session.cjs",
    "service:split-test": "electron scripts/test-service-session.cjs --split-ip",
    "service:stability-test": "electron scripts/test-split-stability.cjs",
    "service:routing-test": "electron scripts/test-split-routing.cjs",
    "service:latency-benchmark": "electron scripts/test-split-routing.cjs --latency-benchmark",
    "native:release": "node scripts/build-release.cjs",
    "package:windows": "npm run format && npm run check && npm run native:release && node scripts/package-windows.cjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test electron/*.test.cjs",
    "check": "npm run format:check && npm test && npm run build && npm run engine:build && npm run service:build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "latest",
    "country-flag-icons": "^1.6.20",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "prettier": "3.9.6",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.gamepath.client",
    "productName": "GamePath",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine/target/release/gamepath-engine.exe",
        "to": "engine/target/release/gamepath-engine.exe"
      },
      {
        "from": "engine/src",
        "to": "engine/src"
      },
      {
        "from": "engine/Cargo.toml",
        "to": "engine/Cargo.toml"
      },
      {
        "from": "engine/Cargo.lock",
        "to": "engine/Cargo.lock"
      },
      {
        "from": "service/target/release/gamepath-service.exe",
        "to": "service/target/release/gamepath-service.exe"
      },
      {
        "from": "relay/src",
        "to": "relay/src"
      },
      {
        "from": "relay/Cargo.toml",
        "to": "relay/Cargo.toml"
      },
      {
        "from": "relay/Cargo.lock",
        "to": "relay/Cargo.lock"
      },
      {
        "from": "vendor/wintun",
        "to": "vendor/wintun"
      },
      {
        "from": "vendor/windivert",
        "to": "vendor/windivert"
      },
      {
        "from": "deploy",
        "to": "deploy"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "GamePath-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GamePath",
      "include": "build/installer.nsh"
    }
  }
}
